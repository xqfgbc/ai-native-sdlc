#!/bin/sh
# .githooks/commit-msg — enforce the ticket-based commit format:
#   [<name>] #<ticket> <type>: <summary>
# AI-generated code uses [AI-Agent]; no ticket uses #N/A.
set -e
msg_file="$1"
first="$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -1)"
case "$first" in
  "Merge "*|"Revert "*) exit 0 ;;
esac
printf '%s' "$first" | grep -Eq '^\[[^]]+\] #[A-Za-z0-9._/-]+ (feat|fix|refactor|docs|chore|test|perf|ci|build|revert): .+' || {
  echo "commit-msg: format is '[<name>] #<ticket> <type>: <summary>' (ticket N/A when none; AI-generated code uses AI-Agent)." >&2
  echo "commit-msg: example '[AI-Agent] #AC-1020 feat: add new processor for BMI3 calculation'." >&2
  echo "commit-msg: got: ${first:-<empty>}" >&2
  exit 1
}
