{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make itest)",
      "Bash(./gradlew *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/install-hooks.sh\" >/dev/null 2>&1 || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/cognition-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/production-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/commit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/no-secrets.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/protect-paths.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/spring-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/test-freeze.sh"
          }
        ]
      }
    ]
  }
}
